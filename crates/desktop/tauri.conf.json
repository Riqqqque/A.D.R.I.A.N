{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "A.D.R.I.A.N.",
  "version": "0.15.1",
  "identifier": "ai.adrian.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "A.D.R.I.A.N.",
        "width": 460,
        "height": 600,
        "minWidth": 340,
        "minHeight": 420,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "center": true,
        "backgroundColor": "#06080b",
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
